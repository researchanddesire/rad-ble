  "keywords": ["ble", "esp32", "nimble", "research-and-desire"],
  "repository": {
    "type": "git",
    "url": "https://github.com/researchanddesire/rad-ble.git"
  },
  "authors": [
    {
      "name": "Research and Desire",
      "url": "https://www.researchanddesire.com"
    }
  ],
  "license": "CERN-OHL-S-2.0",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": ["RadBle.h"],
  "dependencies": {
    "h2zero/NimBLE-Arduino": "2.4.0",
    "bblanchon/ArduinoJson": "^7.4.2"
  },
  "export": {
    "include": [
      "src",
      "protocol",
      "examples",
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "library.json"
